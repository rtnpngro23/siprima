# Copy the required keys into process environment or app/config/.env; never commit real secrets.
MOBILE_API_ENABLED=false
# HTTP is accepted only with BOTH APP_ENV=local and this debug flag.
MOBILE_API_ALLOW_HTTP=false
APP_ENV=production
APP_PUBLIC_URL=https://siprima.example.invalid
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=replace_with_database
DB_USER=replace_with_user
DB_PASS=replace_with_secret
# Existing SMTP_* environment configuration is reused for self-service password reset.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=replace_with_sender
SMTP_PASSWORD=replace_with_secret
# Use a private writable directory; same throttle directory as the website.
# LOGIN_THROTTLE_DIR=/home/account/private_security/login_throttle
# LOGIN_TRUSTED_PROXIES=127.0.0.1
