# ==============================================================================
# SIPRIMA - Environment Configuration Template
# Salin file ini menjadi `app/config/.env` (lokasi aktif yang dibaca koneksi.php)
# dan isi nilai aktual di server. JANGAN PERNAH commit `app/config/.env`.
# ==============================================================================

# --- Database Configuration ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASS=replace_with_database_password

# --- Application & Security ---
APP_NAME="SI PRIMA"
# Gunakan "production" di server live, atau "local" hanya untuk pengembangan lokal
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
# URL publik HTTPS aplikasi (contoh: https://siprima.gorontalokab.go.id)
APP_PUBLIC_URL=https://siprima.example.invalid
APP_URL=https://siprima.example.invalid
# Direktori privat di luar public web root untuk log keamanan & login throttle
# APP_SESSION_SECRET=replace_with_random_64_hex_secret
# SIPRIMA_LOG_DIR=/var/siprima_private/logs
# LOGIN_THROTTLE_DIR=/var/siprima_private/login_throttle
# LOGIN_TRUSTED_PROXIES=127.0.0.1

# --- WhatsApp Gateway (Notifikasi Pemohon KIA - Multi-Provider) ---
# Aktifkan hanya setelah akun provider, token, dan template Meta disetujui
WA_GATEWAY_ENABLED=false
# Pilihan provider: meta_cloud (resmi Meta WhatsApp Cloud API) | fonnte (alternatif)
WA_GATEWAY_PROVIDER=meta_cloud
# Verifikasi sertifikat TLS/SSL cURL (WAJIB true di produksi)
WA_SSL_VERIFY=true

# [A] Konfigurasi Meta WhatsApp Business Platform (Cloud API)
WA_META_API_VERSION=v22.0
WA_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WA_META_WABA_ID=replace_with_meta_waba_id
WA_META_ACCESS_TOKEN=replace_with_permanent_system_user_token
WA_META_TEMPLATE_LANG=id
# Nama Approved Message Template di WhatsApp Manager (kategori UTILITY, bahasa id)
WA_META_TPL_KIA_DIAJUKAN=siprima_kia_diajukan
WA_META_TPL_KIA_PERBAIKAN=siprima_kia_perbaikan
WA_META_TPL_KIA_SELESAI=siprima_kia_selesai
WA_META_TPL_KIA_PDF_TERSEDIA=siprima_kia_pdf_tersedia
WA_META_TPL_KIA_BALASAN_LAPORAN=siprima_kia_tanggapan_laporan
WA_META_TPL_KIA_PDF_PENGGANTI=siprima_kia_pdf_pengganti
WA_META_TPL_KIA_SELESAI_DICETAK=siprima_kia_siap_diambil

# [B] Konfigurasi Fonnte (Provider Alternatif - tetap dipertahankan)
WA_GATEWAY_URL=https://api.fonnte.com/send
WA_API_KEY=replace_with_fonnte_api_key
# Opsional: nomor pengirim terdaftar
WA_SENDER=

# --- Email (SMTP) Notification & Password Reset ---
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SENDER_NAME="SI PRIMA Dukcapil"
ADMIN_EMAIL=admin@example.invalid
SUPPORT_EMAIL=support@example.invalid

# --- Telegram Bot (Opsional: Whistleblowing & Reset Password Admin) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id

# --- Whistleblowing Public API ---
WBS_PUBLIC_API_TOKEN=replace_with_random_64_char_secret

# --- ASPRIMA AI Assistant (Opsional, otomatis fallback ke panduan lokal bila kosong) ---
ASPRIMA_AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Mobile API Configuration ---
MOBILE_API_ENABLED=false
MOBILE_API_ALLOW_HTTP=false
